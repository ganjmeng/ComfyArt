  "title": "Meta Ads Creative",
  "description": "Creates and optimizes ecommerce paid-social visual assets for Meta, Facebook, and Instagram campaigns.",
  "status": "passed",
  "visibility": "PUBLIC",
  "content": {
    "skillPreset": {
      "i18n_title": {
        "en": "Meta Ads Creative",
        "ja": "Meta広告クリエイティブ",
        "zh": "Meta广告创意"
      },
      "i18n_description": {
        "en": "Creates and optimizes ecommerce paid-social visual assets for Meta, Facebook, and Instagram campaigns.",
        "ja": "Meta、Facebook、Instagram向けに、EC商品の広告ビジュアル、テスト案、配信用バリエーションを制作します。",
        "zh": "为电商产品生成 Meta、Facebook、Instagram 投放视觉素材，包括 Feed、Stories、Reels 静态广告、轮播卡片、测试方向与批量变体。"
      },
      "prompts": [
        {
          "title": "Create Meta Ad Creative Directions",
          "content": "Create Meta ad creative directions for this product, suitable for Facebook and Instagram campaigns. Use my uploaded product images and brand information to generate 3 distinct visual directions first."
        },
        {
          "title": "Design a Meta Feed Ad",
          "content": "Design a Meta Feed ad for this product, highlighting the key selling point, offer, and call to action. The layout should work well on mobile and have a clear conversion-focused hierarchy."
        },
        {
          "title": "Create an Instagram Stories Ad",
          "content": "Create a vertical Instagram Stories ad for this product in a 9:16 format. Highlight the product, main selling point, and CTA, with text that stays clear and readable on mobile screens."
        }
      ],
      "i18n_prompts": {
        "en": [
          {
            "title": "Create Meta Ad Creative Directions",
            "content": "Create Meta ad creative directions for this product, suitable for Facebook and Instagram campaigns. Use my uploaded product images and brand information to generate 3 distinct visual directions first."
          },
          {
            "title": "Design a Meta Feed Ad",
            "content": "Design a Meta Feed ad for this product, highlighting the key selling point, offer, and call to action. The layout should work well on mobile and have a clear conversion-focused hierarchy."
          },
          {
            "title": "Create an Instagram Stories Ad",
            "content": "Create a vertical Instagram Stories ad for this product in a 9:16 format. Highlight the product, main selling point, and CTA, with text that stays clear and readable on mobile screens."
          }
        ],
        "ja": [
          {
            "title": "Meta広告のクリエイティブ方向を作成",
            "content": "この商品のMeta広告クリエイティブ方向を作成してください。FacebookとInstagramでの配信に適した内容にし、アップロードした商品画像とブランド情報をもとに、まず3つの異なるビジュアル方向を提案してください。"
          },
          {
            "title": "Meta Feed広告画像をデザイン",
            "content": "この商品のMeta Feed広告画像をデザインしてください。主な訴求点、オファー、CTAを目立たせ、モバイルで見やすく、広告として伝わりやすい構成にしてください。"
          },
          {
            "title": "Instagram Stories広告を作成",
            "content": "この商品のInstagram Stories向け縦型広告画像を作成してください。9:16の全画面表示に適した構成で、商品、主な訴求点、CTAを強調し、スマートフォンでも文字が読みやすいようにしてください。"
          }
        ],
        "zh": [
          {
            "title": "制作 Meta 广告创意方向",
            "content": "请为这个产品制作 Meta 广告创意方向，适用于 Facebook 和 Instagram 投放。请基于我上传的产品图和品牌信息，先生成 3 个不同的广告视觉方向。"
          },
          {
            "title": "设计 Meta Feed 广告图",
            "content": "请为这个产品设计 Meta Feed 广告图，突出核心卖点、优惠信息和行动号召，画面需要适合移动端浏览，并保持清晰的广告转化层级。"
          },
          {
            "title": "创建 Instagram Stories 广告",
            "content": "请为这个产品创建 Instagram Stories 竖版广告图，适合 9:16 全屏展示，突出产品、卖点和 CTA，并保证文字在手机屏幕上清晰可读。"
          }
        ]
      },
      "i18n_prompt": {
        "en": "Create Meta ad creative directions for this product, suitable for Facebook and Instagram campaigns. Use my uploaded product images and brand information to generate 3 distinct visual directions first.",
        "ja": "この商品のMeta広告クリエイティブ方向を作成してください。FacebookとInstagramでの配信に適した内容にし、アップロードした商品画像とブランド情報をもとに、まず3つの異なるビジュアル方向を提案してください。",
        "zh": "请为这个产品制作 Meta 广告创意方向，适用于 Facebook 和 Instagram 投放。请基于我上传的产品图和品牌信息，先生成 3 个不同的广告视觉方向。"
      }
    },
