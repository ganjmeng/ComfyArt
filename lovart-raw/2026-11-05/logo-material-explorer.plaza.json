  "content": {
    "skillPreset": {
      "i18n_title": {
        "en": "Logo Material Explorer",
        "ja": "ロゴマテリアルエクスプローラー",
        "zh": "标志材质探索器"
      },
      "i18n_description": {
        "en": "Explore premium 3D materials for uploaded logos through a controlled C4D-style workflow. The skill helps confirm the logo target, generate neutral white-model previews, create preset or reference-driven material studies, and apply confirmed materials while preserving the original logo identity.",
        "ja": "アップロードされたロゴに対して、C4Dスタイルの制御されたワークフローを通じてプレミアム3Dマテリアルを探索します。このスキルは、ロゴターゲットの確認、ニュートラルなホワイトモデルプレビューの生成、プリセットまたはリファレンス駆動のマテリアルスタディの作成、オリジナルのロゴアイデンティティを保持したまま確定したマテリアルの適用を支援します。",
        "zh": "通过受控的C4D风格工作流程，为上传的标志探索高级3D材质。该技能帮助确认标志目标、生成中性白色模型预览、创建预设或参考驱动的材质研究，并在保留原始标志特征的同时应用确认的材质。"
      },
      "prompts": [
        {
          "title": "Explore preset materials",
          "content": "I uploaded a logo. Please help me explore preset 3D materials for it."
        }
      ],
      "i18n_prompts": {
        "en": [
          {
            "title": "Explore preset materials",
            "content": "I uploaded a logo. Please help me explore preset 3D materials for it."
          }
        ]
      },
      "i18n_prompt": {
        "en": "I uploaded a logo. Please help me explore preset 3D materials for it.",
        "ja": "ロゴをアップロードしました。プリセットの3Dマテリアルを探索するのを手伝ってください。",
        "zh": "我上传了一个标志。请帮我探索预设的3D材质。"
      }
    },
