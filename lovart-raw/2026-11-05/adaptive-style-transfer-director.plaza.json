  "title": "Adaptive Style Transfer Director",
  "description": "Analyze, transfer, and control reference styles",
  "status": "passed",
  "visibility": "PUBLIC",
  "content": {
    "skillPreset": {
      "i18n_title": {
        "en": "adaptive-style-transfer-director",
        "ja": "万能スタイル再現",
        "zh": "万能风格复刻"
      },
      "i18n_description": {
        "en": "An adaptive reference image style transfer tool that can identify the user's intention and the reference purpose, analyze and extract visual styles, generate reusable prompts, mood boards, style image solutions and series plans. It is applicable to the style analysis, replication, transfer and controlled variant creation of reference images such as graphic designs, illustrations, and UI.",
        "ja": "リファレンス画像に適応するスタイルマイグレーションツール。ユーザーの意図と参考目的を認識し、視覚的なスタイルを分析・抽出して、再利用可能なプロンプト、ムードボード、同スタイルの画像案およびシリーズ企画を生成します。グラフィックビジュアル、イラスト、UIなどの参考画像のスタイル解析、再現、転移、および制御可能なバリエーション創作に対応。",
        "zh": "自适应参考图风格迁移工具，可识别用户意图与参考目的，分析并提炼视觉风格，生成可复用提示词、情绪板、同风格图像方案及系列规划。适用于平面视觉、插画、UI 等参考图的风格解析、复刻、迁移与可控变体创作。"
      },
      "prompts": [
        {
          "title": "One-Click Precise Style Replication",
          "content": "Refer to the attached image and generate a new image with the identical style."
        },
        {
          "title": "Deep Style Prompt Reverse Engineering",
          "content": "Analyze and describe the artistic style of the attached image."
        }
      ],
      "i18n_prompts": {
        "en": [
          {
            "title": "One-Click Precise Style Replication",
            "content": "Refer to the attached image and generate a new image with the identical style."
          },
          {
            "title": "Deep Style Prompt Reverse Engineering",
            "content": "Analyze and describe the artistic style of the attached image."
          }
        ],
        "ja": [
          {
            "title": "スタイルをワンクリックで正確に再現",
            "content": "添付画像を参考に、同じスタイルの新しい画像を生成してください。"
          },
          {
            "title": "深層スタイルプロンプト逆推定",
            "content": "添付画像のスタイルを詳細に説明してください。"
          }
        ],
        "zh": [
          {
            "title": "风格一键精准复刻",
