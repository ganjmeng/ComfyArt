        "i18n": {
          "zh": {
            "title": "自定义复刻",
            "description": "完整视频复刻成片 1 条",
            "ctaText": "复刻参考视频"
          },
          "en": {
            "title": "Custom Remake",
            "description": "1 finished reference-video remake",
            "ctaText": "Remake video"
          }
        },
        "media": [
          {
            "role": "RESULT",
            "url": "https://web-static3.lovart.ai/static-assets/v1/sha256/29/293ba1c0bf75ef67d6ae4446da24718c7aadc545c0128e357685a2aff3176699.mp4",
            "coverWidth": 1440,
            "coverHeight": 1920
          }
        ],
        "bind": {
          "type": "SKILL",
          "source": "MANUAL",
          "skillKey": "video-remake",
          "skillAssetId": "pnFlBbT0Zy",
          "versionId": "8c027ab4-ba6b-4faa-9052-7c131749ef03",
          "skillId": "industry/video-remake/8c027ab4-ba6b-4faa-9052-7c131749ef03",
          "namespace": "industry",
          "sourceVersion": "1.0.19"
        },
        "template": {
          "version": 1,
          "questions": [
            {
              "key": "reference_video",
              "type": "VIDEO_UPLOAD",
              "required": true,
              "i18n": {
                "zh": {
                  "title": "参考视频",
                  "placeholder": "上传视频文件"
                },
                "en": {
                  "title": "Reference video file",
                  "placeholder": "Upload your source video."
                }
              },
              "limits": {
                "maxCount": 3,
                "maxSizeMb": 100
              }
            },
            {
              "key": "replacement_brief",
              "type": "TEXT",
              "required": true,
              "i18n": {
                "zh": {
                  "title": "复刻要求",
                  "placeholder": "希望替换或保留哪些内容？可同时描述商品、人物、品牌、文案等多项改动。"
                },
                "en": {
                  "title": "Remake brief",
                  "placeholder": "What should change or stay? Combine product, person, brand, copy or other requested changes."
                }
              },
              "limits": {
                "maxLength": 200
              }
            },
            {
              "key": "replacement_assets",
              "type": "IMAGE_UPLOAD",
              "required": false,
              "i18n": {
                "zh": {
                  "title": "替换素材图片（选填）"
                },
                "en": {
                  "title": "Replacement images (optional)"
                }
              },
              "limits": {
                "maxCount": 9,
                "maxSizeMb": 10,
                "accept": [
                  "image/jpeg",
                  "image/png",
                  "image/webp"
                ]
              }
            },
            {
              "key": "asset_links",
              "type": "FILE_UPLOAD",
              "required": false,
              "i18n": {
                "zh": {
                  "title": "其他素材",
                  "placeholder": "其他文件或素材可填在这里；没有可留空。"
                },
                "en": {
                  "title": "Other asset",
                  "placeholder": "Add other file or asset here. Leave blank if unavailable."
                }
              },
              "limits": {
                "maxCount": 3,
                "maxSizeMb": 20
              }
            },
            {
              "key": "visual_direction",
              "type": "TEXT",
              "required": false,
              "i18n": {
                "zh": {
                  "title": "视觉呈现方式",
                  "placeholder": "描述希望的视觉效果或提供参考；没有要求可留空。"
                },
                "en": {
                  "title": "Visual direction",
                  "placeholder": "Describe your preferred visual treatment or provide a reference. Leave blank if you have no preference."
                }
              },
              "limits": {
                "maxLength": 200
              }
            }
          ],
          "inputTemplate": {
            "zh": "根据用户提供的参考视频和复刻要求，制作 1 条完整复刻视频。可在同一次任务中组合替换商品、人物、品牌、文案或其他明确指定内容；先确认各项替换目标、素材对应、作用范围及必要联动。保留未要求改变的原片镜头结构、节奏和内容关系；画幅、清晰度与音轨处理确认后制作，不默认把所有元素都替换。\n\n参考视频链接: {{reference_video}}\n复刻要求: {{replacement_brief}}\n其他素材链接: {{asset_links}}\n视觉呈现方式: {{visual_direction}}",
            "en": "Create 1 complete remake from the supplied reference video and brief. Combine product, person, brand, copy or other explicitly requested changes in one task. Confirm targets, asset mappings, scope and necessary dependent changes. Preserve unspecified shot structure, pacing and relationships; confirm ratio, resolution and audio treatment before production. Do not replace every element by default.\n\nReference video URL: {{reference_video}}\nRemake brief: {{replacement_brief}}\nOther asset URLs: {{asset_links}}\nVisual direction: {{visual_direction}}"
          },
          "renderRules": {
            "joinSeparator": "、",
            "omitEmptyLine": true
          }
        },
