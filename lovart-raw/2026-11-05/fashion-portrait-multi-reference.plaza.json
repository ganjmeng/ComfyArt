    "skillPreset": {
      "i18n_title": {
        "en": "E-commerce 3-Image Person Swap",
        "ja": "Eコマース3枚画像人物交換",
        "zh": "电商3图换人"
      },
      "i18n_description": {
        "en": "Based on three reference images—AI photography, AI model face, and real outfit coordination—synthesize a fashion blockbuster with unchanged pose and scene, only swapping the person and outfit.",
        "ja": "AI撮影画像、AIモデルの顔、実際の服装コーディネートの3枚の参考画像に基づき、ポーズとシーンは変えず、人物と服装のみを入れ替えたファッション大作を合成します。",
        "zh": "基于AI拍摄图、AI模特脸、真实服装搭配三张参考图，合成姿势与场景不变、仅换人换装的时尚大片。"
      },
      "i18n_prompt": {
        "en": "Upload reference image 1 (scene + pose + composition), reference image 2 (model face), reference image 3 (outfit), to generate a 2K/3:4 vertical fashion blockbuster; by default outputs a half-body shot consistent with reference image 1 composition, or you can specify \"full body\" in requirements to switch composition.",
        "ja": "参考画像1（シーン+ポーズ+構図）、参考画像2（モデルの顔）、参考画像3（服装）をアップロードし、2K/3:4縦画像のファッション大作を生成します。デフォルトでは参考画像1の構図と一致するバストショットを出力しますが、要件で「全身」を指定して構図を切り替えることもできます。",
        "zh": "上传参考图1（场景+姿势+构图）、参考图2（模特脸）、参考图3（服装），生成一张2K/3:4竖图的时尚大片；默认输出与参考图1构图一致的半身图，也可在需求中指定“全身”切换构图。"
      }
    },
