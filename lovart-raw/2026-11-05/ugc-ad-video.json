        "template": {
          "version": 1,
          "questions": [
            {
              "key": "product_images",
              "type": "IMAGE_UPLOAD",
              "required": true,
              "i18n": {
                "zh": {
                  "title": "商品图片"
                },
                "en": {
                  "title": "Product images"
                }
              },
              "limits": {
                "maxCount": 9,
                "maxSizeMb": 10,
                "accept": [
                  "image/jpeg",
                  "image/png",
                  "image/webp"
                ]
              }
            },
            {
              "key": "product_info",
              "type": "TEXT",
              "required": false,
              "i18n": {
                "zh": {
                  "title": "商品资料",
                  "placeholder": "补充商品名称、已确认卖点和实际使用方式；没有可留空。"
                },
                "en": {
                  "title": "Product information",
                  "placeholder": "Add the product name, confirmed selling points and actual usage. Leave blank if unavailable."
                }
              },
              "limits": {
                "maxLength": 200
              }
            },
            {
              "key": "brief",
              "type": "TEXT",
              "required": false,
              "i18n": {
                "zh": {
                  "title": "补充要求",
                  "placeholder": "补充用途、文案、时长或声音要求；不确定可留空，后续确认。"
                },
                "en": {
                  "title": "Additional requirements",
                  "placeholder": "Add placement, copy, duration or audio requirements. Leave undecided details blank for later confirmation."
                }
              },
              "limits": {
                "maxLength": 200
              }
            },
            {
              "key": "visual_direction",
              "type": "TEXT",
              "required": false,
              "i18n": {
                "zh": {
                  "title": "视觉呈现方式",
                  "placeholder": "描述希望的视觉效果或提供参考；没有要求可留空。"
                },
                "en": {
                  "title": "Visual direction",
                  "placeholder": "Describe your preferred visual treatment or provide a reference. Leave blank if you have no preference."
                }
              },
              "limits": {
                "maxLength": 200
              }
            }
          ],
          "inputTemplate": {
            "zh": "制作 1 条完整的 UGC 产品种草视频，围绕真实商品、已确认卖点和用户需求建立自然可信的购买理由。由 Skill 规划适合的叙事，可按需组合口播、使用演示、开箱或生活植入，不预设固定组合、顺序或视觉风格。先确认主商品与素材对应、画幅、时长和成片语言，再展示三套完整脚本供选择；选定脚本后确定人物并完成成片。不虚构产品事实、包装配件、买家证言或使用经历。\n\n商品资料: {{product_info}}\n补充要求: {{brief}}\n视觉呈现方式: {{visual_direction}}",
            "en": "Create 1 finished UGC product-recommendation video using the actual product, confirmed selling points and user needs. Let the Skill choose appropriate storytelling, combining presentation, demonstration, unboxing or everyday use when useful, without a preset mix, order or visual style. Confirm product mapping, ratio, duration and output language, then present three complete script proposals. Select one script before casting and production. Do not fabricate product facts, packaging, accessories, testimonials or experience.\n\nProduct information: {{product_info}}\nAdditional requirements: {{brief}}\nVisual direction: {{visual_direction}}"
          },
          "renderRules": {
            "joinSeparator": "、",
            "omitEmptyLine": true
          }
        },
