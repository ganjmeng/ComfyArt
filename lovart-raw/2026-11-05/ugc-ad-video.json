          }
        },
        "media": [
          {
            "role": "RESULT",
            "url": "https://web-static3.lovart.ai/static-assets/v1/sha256/8b/8b793748fac4cdea1f28a6103b2cbbee6a3433579cc833ed91cd5508275b30bb.mp4",
