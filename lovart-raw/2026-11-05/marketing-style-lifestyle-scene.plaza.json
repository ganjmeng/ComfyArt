    "skillPreset": {
      "i18n_title": {
        "en": "E-commerce Lifestyle Scene Designer",
        "ja": "EC文字なしライフスタイルシーン画像デザイナー",
        "zh": "电商场景氛围图设计"
      },
      "i18n_description": {
        "en": "Blends products into realistic lifestyle scenes, home decors, or daily outfits to create highly immersive, textless visuals.",
        "ja": "商品をリアルな生活シーンやインテリア、日常のコーディネートに溶け込ませ、購買意欲をそそる文字なし画像を生成します。",
        "zh": "将商品完美融入真实的生活场景、居家氛围或日常穿搭中，生成极具购买代入感的无字大片。"
      },
      "prompts": [
        {
          "title": "Home & Decor: Desk Lamp Lifestyle Scene",
          "content": "Help me design a textless lifestyle scene image for this desk lamp. The visual should feel immersive, blending into a warm and cozy home environment, optimized for mobile viewing."
        }
      ],
      "i18n_prompts": {
        "en": [
          {
            "title": "Home & Decor: Desk Lamp Lifestyle Scene",
            "content": "Help me design a textless lifestyle scene image for this desk lamp. The visual should feel immersive, blending into a warm and cozy home environment, optimized for mobile viewing."
          }
        ],
        "ja": [
          {
            "title": "ホーム＆デコ：デスクライトのライフスタイルシーン",
            "content": "このデスクライトの文字なしライフスタイルシーン画像を作成してください。温かみのある心地よいホーム環境に溶け込ませ、生活感と代入感のあるビジュアルにし、スマホでの閲覧に最適化されたレイアウトにしてください。"
          }
        ],
        "zh": [
          {
            "title": "家居生活：台灯场景图设计",
            "content": "帮我为这款台灯设计一张无文字场景氛围图。画面需要有生活代入感，融入温馨舒适的居家环境，适合手机端快速浏览。"
          }
        ]
      },
      "i18n_prompt": {
        "en": "Help me design a textless lifestyle scene image for this desk lamp. The visual should feel immersive, blending into a warm and cozy home environment, optimized for mobile viewing.",
        "ja": "このデスクライトの文字なしライフスタイルシーン画像を作成してください。温かみのある心地よいホーム環境に溶け込ませ、生活感と代入感のあるビジュアルにし、スマホでの閲覧に最適化されたレイアウトにしてください。",
        "zh": "帮我为这款台灯设计一张无文字场景氛围图。画面需要有生活代入感，融入温馨舒适的居家环境，适合手机端快速浏览。"
      }
