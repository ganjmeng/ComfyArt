+// #247 preview: setup guide for external agent tools (copy to be confirmed by product)
+const AGENT_DOCS: Record<string, string> = {
+  'claude-code': 'https://docs.claude.com/en/docs/claude-code/overview',
+  codex: 'https://developers.openai.com/codex/cli',
+  'qwen-code': 'https://github.com/QwenLM/qwen-code',
+  opencode: 'https://opencode.ai/docs',
+  'gemini-cli': 'https://github.com/google-gemini/gemini-cli',
+}
+function AgentSetup({ providers, enabled, onError }: { providers: ProviderInfo[]; enabled: boolean | null; onError: (msg: string) => void }) {
+  const [copied, setCopied] = useState<string | null>(null)
+  const [checking, setChecking] = useState(false)
+  const config = JSON.stringify({ mcpServers: { comfyart: { type: 'http', url: `${location.origin}/comfyart/mcp` } } }, null, 2)
+  const copy = (id: string) => void navigator.clipboard?.writeText(config).then(() => { setCopied(id); setTimeout(() => setCopied(null), 1500) }).catch(() => {})
+  const focus = useValue(agentSetupFocusAtom)
+  const [lit, setLit] = useState<string | null>(null)
+  useEffect(() => {
+    if (!focus) return
+    document.querySelector(`.ca-agentsetup__card[data-agent="${focus}"]`)?.scrollIntoView({ block: 'center' })
+    setLit(focus); agentSetupFocusAtom.set(null)
+    const tm = setTimeout(() => setLit(null), 2400)
+    return () => clearTimeout(tm)
+  }, [focus])
+  const check = () => { setChecking(true); void refreshBot().catch((e) => onError(errorText(e))).finally(() => setChecking(false)) }
+  return (
+    <section className="ca-agentsetup" data-testid="agent-setup">
+      <div className="ca-gen__label">{t('agentSetup.title')}</div>
+      <div className="ca-chat__hint">{t('agentSetup.desc')}</div>
+      {!enabled && <div className="ca-chat__hint">{t('botSettings.availableAgentsOnThisMachine')}</div>}
+      {providers.filter((p) => p.id !== BUILTIN_AGENT).map((p) => (
+        <div key={p.id} className="ca-agentsetup__card" data-agent={p.id} data-lit={lit === p.id || undefined}>
+          <div className="ca-agentsetup__head">
+            <span className="ca-agentsetup__name">{providerLabel(p)}</span>
+            <span className="ca-agentsetup__chip" data-on={p.available || undefined}>{p.available ? t('agentSetup.connected') : t('agentPicker.notDetected')}</span>
+          </div>
+          <ol className="ca-agentsetup__steps">
+            <li>
+              <span>{t('agentSetup.install')}</span>
+              {AGENT_DOCS[p.id] ? <a href={AGENT_DOCS[p.id]} target="_blank" rel="noopener noreferrer">{t('agentSetup.officialDocs')}</a> : <span className="ca-menu__key">{t('agentSetup.docsTbd')}</span>}
+            </li>
+            <li>
+              <span>{t('agentSetup.connect')}</span>
+              <div className="ca-agentsetup__code"><pre>{config}</pre><button type="button" className="ca-panel__secondary" onClick={() => copy(p.id)}>{copied === p.id ? t('agentSetup.copied') : t('agentSetup.copy')}</button></div>
+            </li>
+            <li>
+              <button type="button" className="ca-panel__secondary" disabled={checking} onClick={check}>{t('agentSetup.checkAgain')}</button>
+            </li>
+          </ol>
+          <a className="ca-agentsetup__guide" href={`${docsUrl()}/guides/mcp`} target="_blank" rel="noopener noreferrer">{t('agentSetup.viewGuide')}</a>
+        </div>
+      ))}
+    </section>
+  )
+}
